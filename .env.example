# Server bind configuration (leave empty to use defaults: PORT=3000, HOST=0.0.0.0)
PORT=
HOST=
BACHATHUB_DIST_DIR=

# Set to 1 to disable all seeded demo deals/brands/fake alerts/bank cards/demo users
BACHATHUB_NO_DEMO=

# Super Admin Passcode & Recovery Email (leave empty here; set in your runtime/Electron env)
ADMIN_PASSCODE=
ADMIN_RECOVERY_EMAIL=

# 32-byte (64 hex chars) AES-256-GCM encryption key for GitHub vault shards
DATA_ENCRYPTION_KEY=

# Pure GitHub-Only Repository Sync & Actions Workflow Dispatch
GITHUB_TOKEN=
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=
GITHUB_BRANCH=

# SMTP Email Delivery for Super Admin Forgot-Passcode 6-Digit OTP
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Static Frontend Build Options (GitHub Pages / Android APK)
VITE_STATIC_MODE=
VITE_BASE=
