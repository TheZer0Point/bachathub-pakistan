rules_version = '2';
// BachatHub Pakistan - Firestore security rules (paste into Firebase console -> Firestore -> Rules).
// Customers sign in anonymously (no account). The admin signs in with the verified email below.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'z.point2018@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function notBlocked() { return !exists(/databases/$(database)/documents/blocked/$(request.auth.uid)); }
    function textOk(t) {
      return t is string && t.size() <= 500
        && !t.matches('(?is).*(https?://|www[.]).*')
        && !t.matches('(?s).*(\\+92|0)?3[0-9]{2}[ -]?[0-9]{7}.*');
    }
    function firstReaction(id, kind) {
      return existsAfter(/databases/$(database)/documents/messageReactions/$(id + '_' + request.auth.uid + '_' + kind))
        && !exists(/databases/$(database)/documents/messageReactions/$(id + '_' + request.auth.uid + '_' + kind));
    }

    // ---- community chat
    match /communities/{city}/messages/{id} {
      allow read: if true;
      allow create: if signedIn() && notBlocked()
        && request.resource.data.senderId == request.auth.uid
        && textOk(request.resource.data.text)
        && request.resource.data.likes == 0
        && request.resource.data.reportsCount == 0
        && request.resource.data.hidden == false
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/limits/$(request.auth.uid)).data.lastAt == request.time;
      allow update: if isAdmin()
        || (signedIn()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
            && request.resource.data.likes == resource.data.likes + 1
            && firstReaction(id, 'like'))
        || (signedIn()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportsCount'])
            && request.resource.data.reportsCount == resource.data.reportsCount + 1
            && firstReaction(id, 'report'));
      allow delete: if isAdmin();
    }

    // slow mode: one message every 8 seconds per device
    match /limits/{uid} {
      allow read: if false;
      allow create: if signedIn() && uid == request.auth.uid && request.resource.data.lastAt == request.time;
      allow update: if signedIn() && uid == request.auth.uid && request.resource.data.lastAt == request.time
        && request.time > resource.data.lastAt + duration.value(8, 's');
    }

    match /messageReactions/{rid} {
      allow read: if false;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.action in ['like', 'report']
        && rid == request.resource.data.messageId + '_' + request.auth.uid + '_' + request.resource.data.action;
    }

    // ---- votes & reactions (public read so the GitHub scraper can count them)
    match /dealVotes/{vid} {
      allow read: if true;
      allow create, update: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.value in ['real', 'fake']
        && vid == request.resource.data.dealId + '_' + request.auth.uid;
    }
    match /brandReactions/{vid} {
      allow read: if true;
      allow create, update: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.value in ['like', 'dislike']
        && vid == request.resource.data.brandId + '_' + request.auth.uid;
    }
    match /fakeVotes/{vid} {
      allow read: if true;
      allow create, update: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.value in ['confirm', 'receipt']
        && vid == request.resource.data.alertId + '_' + request.resource.data.value + '_' + request.auth.uid;
    }

    // ---- inbox for the admin: customers can only send, admin reads/decides
    match /submissions/{id} {
      allow create: if signedIn() && notBlocked() && request.resource.data.uid == request.auth.uid && request.resource.data.status == 'pending';
      allow read, update, delete: if isAdmin();
    }
    match /feedback/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.status == 'open';
      allow read, update, delete: if isAdmin();
    }
    match /appeals/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.status == 'pending';
      allow read, update, delete: if isAdmin();
    }

    // ---- support chat: each device sees only its own tickets
    match /supportTickets/{id} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.messages.size() == 1;
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['messages', 'status', 'updatedAt'])
            && request.resource.data.messages.size() == resource.data.messages.size() + 1
            && request.resource.data.status == 'open');
      allow delete: if isAdmin();
    }

    // ---- blocked devices (set by admin)
    match /blocked/{uid} {
      allow read: if signedIn() && (uid == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }
  }
}
